.env
.config/nvim/plugin/
.config/nvim/lazy-lock.json
**.code-workspace

# Zsh completion cache files
.zcompdump*
.config/zsh/.zcompdump*

# Antidote generated files
.config/zsh/.zsh_plugins.zsh
.config/zsh/.zsh_history
.config/tmux/plugins

# Claude command symlinks generated by ~/dotfiles-private/setup-skills.sh
.claude/commands/*.md

# Claude statusline runtime log (grows unbounded)
.claude/statusline.log

# fontconfig per-machine dir id
.local/share/fonts/.uuid
