{
  "permissions": {
    "defaultMode": "auto"
  },
  "model": "claude-fable-5[1m]",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f '/home/rocktim/.orca/agent-hooks/claude-hook.sh' ] && [ -r '/home/rocktim/.orca/agent-hooks/claude-hook.sh' ] && [ -x '/home/rocktim/.orca/agent-hooks/claude-hook.sh' ]; then /bin/sh '/home/rocktim/.orca/agent-hooks/claude-hook.sh'; else cat >/dev/null 2>&1 || :; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/home/rocktim/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f '/home/rocktim/.orca/agent-hooks/claude-hook.sh' ] && [ -r '/home/rocktim/.orca/agent-hooks/claude-hook.sh' ] && [ -x '/home/rocktim/.orca/agent-hooks/claude-hook.sh' ]; then /bin/sh '/home/rocktim/.orca/agent-hooks/claude-hook.sh'; else cat >/dev/null 2>&1 || :; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f '/home/rocktim/.orca/agent-hooks/claude-hook.sh' ] && [ -r '/home/rocktim/.orca/agent-hooks/claude-hook.sh' ] && [ -x '/home/rocktim/.orca/agent-hooks/claude-hook.sh' ]; then /bin/sh '/home/rocktim/.orca/agent-hooks/claude-hook.sh'; else cat >/dev/null 2>&1 || :; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f '/home/rocktim/.orca/agent-hooks/claude-hook.sh' ] && [ -r '/home/rocktim/.orca/agent-hooks/claude-hook.sh' ] && [ -x '/home/rocktim/.orca/agent-hooks/claude-hook.sh' ]; then /bin/sh '/home/rocktim/.orca/agent-hooks/claude-hook.sh'; else cat >/dev/null 2>&1 || :; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f '/home/rocktim/.orca/agent-hooks/claude-hook.sh' ] && [ -r '/home/rocktim/.orca/agent-hooks/claude-hook.sh' ] && [ -x '/home/rocktim/.orca/agent-hooks/claude-hook.sh' ]; then /bin/sh '/home/rocktim/.orca/agent-hooks/claude-hook.sh'; else cat >/dev/null 2>&1 || :; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f '/home/rocktim/.orca/agent-hooks/claude-hook.sh' ] && [ -r '/home/rocktim/.orca/agent-hooks/claude-hook.sh' ] && [ -x '/home/rocktim/.orca/agent-hooks/claude-hook.sh' ]; then /bin/sh '/home/rocktim/.orca/agent-hooks/claude-hook.sh'; else cat >/dev/null 2>&1 || :; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "TeammateIdle": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f '/home/rocktim/.orca/agent-hooks/claude-hook.sh' ] && [ -r '/home/rocktim/.orca/agent-hooks/claude-hook.sh' ] && [ -x '/home/rocktim/.orca/agent-hooks/claude-hook.sh' ]; then /bin/sh '/home/rocktim/.orca/agent-hooks/claude-hook.sh'; else cat >/dev/null 2>&1 || :; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f '/home/rocktim/.orca/agent-hooks/claude-hook.sh' ] && [ -r '/home/rocktim/.orca/agent-hooks/claude-hook.sh' ] && [ -x '/home/rocktim/.orca/agent-hooks/claude-hook.sh' ]; then /bin/sh '/home/rocktim/.orca/agent-hooks/claude-hook.sh'; else cat >/dev/null 2>&1 || :; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f '/home/rocktim/.orca/agent-hooks/claude-hook.sh' ] && [ -r '/home/rocktim/.orca/agent-hooks/claude-hook.sh' ] && [ -x '/home/rocktim/.orca/agent-hooks/claude-hook.sh' ]; then /bin/sh '/home/rocktim/.orca/agent-hooks/claude-hook.sh'; else cat >/dev/null 2>&1 || :; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f '/home/rocktim/.orca/agent-hooks/claude-hook.sh' ] && [ -r '/home/rocktim/.orca/agent-hooks/claude-hook.sh' ] && [ -x '/home/rocktim/.orca/agent-hooks/claude-hook.sh' ]; then /bin/sh '/home/rocktim/.orca/agent-hooks/claude-hook.sh'; else cat >/dev/null 2>&1 || :; fi",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh",
    "padding": 0
  },
  "enabledPlugins": {
    "caveman@caveman": true,
    "claude-mem@thedotmack": true,
    "code-review@claude-plugins-official": true,
    "linear@claude-plugins-official": true,
    "ponytail@ponytail": true,
    "pyright-lsp@claude-plugins-official": true,
    "slack@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "waza@waza": true
  },
  "extraKnownMarketplaces": {
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    },
    "waza": {
      "source": {
        "source": "github",
        "repo": "tw93/Waza"
      }
    }
  },
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "skipDangerousModePermissionPrompt": true,
  "agentPushNotifEnabled": false,
  "skipAutoPermissionPrompt": true,
  "voiceEnabled": true
}
