# Start/attach the `codingal` tmux session, syncing master on first launch
codingal() {
  local session="codingal"
  if ! tmux has-session -t "$session" 2>/dev/null; then
    tmux new-session -d -s "$session" -c ~/main
    tmux send-keys -t "$session" "git checkout master && git pull" C-m
  fi
  if [ -n "$TMUX" ]; then
    tmux switch-client -t "$session"
  else
    tmux attach-session -t "$session"
  fi
}

