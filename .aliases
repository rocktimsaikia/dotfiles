## Directories
alias ..="cd .."
alias D="cd ~/Downloads"
alias P="cd ~/Pictures"
alias V="cd ~/Videos"
alias dot="cd ~/dotfiles"

# Make dir(s) and cd into it
mkcd() { mkdir -p "$1" && cd "$1"; }

alias bat="bat -p"

# Open file in Google Chrome
openbrowser() {
  if [ -z "$1" ]; then
    echo "Usage: openbrowser <file>"
    return 1
  fi
  google-chrome "$1" > /dev/null 2>&1 &
}
alias ob="openbrowser"

# This is needed to make ssh work properly with kitty
# without issues like "terminal is not fully functional"
# alias ssh="kitty +kitten ssh"

# Get the serial-number of current system
alias serial-number="sudo dmidecode -s system-serial-number"

# The single quotes are important here so that the command is not executed immediately
alias firefox='firefox > /dev/null 2>&1 &'
alias chat="google-chrome https://chat.openai.com/ > /dev/null 2>&1"
alias redash="google-chrome https://redash.codingal.com/ > /dev/null 2>&1 &"
alias wiki="google-chrome https://github.com/Codingal/main/wiki > /dev/null 2>&1 &"

alias yt-music="yt-dlp -x --audio-format mp3 --audio-quality 0 -o '$HOME/Downloads/%(title)s.%(ext)s'"
alias yt-video="yt-dlp --no-playlist -f 'bestvideo+bestaudio/best' --merge-output-format mp4 -o '$HOME/Downloads/%(title)s.%(ext)s'"

alias dm="drop-migrations"

# Git restore staged but only the new files
alias grsn='git restore --staged $(git status --porcelain | grep "^A" | awk "{print \$2}")'

# AI skill sync (skills live in ~/agent-skills, separate repo)
sync-ai-skills() {
  [[ -x ~/agent-skills/setup.sh ]] && ~/agent-skills/setup.sh >/dev/null
}

# Claude CLI
cc() { sync-ai-skills; claude --chrome "$@"; }
ccr() { sync-ai-skills; claude --resume "$@"; }
cct() { sync-ai-skills; claude --continue "$@"; }
ccw() { sync-ai-skills; claude --chrome --worktree "$@"; }
alias ccs="claude-session-search"

# Copilot CLI
alias co="copilot"
alias cor="copilot --resume"
alias cot="copilot --continue"

alias fzfone='find . -maxdepth 1 -type f | fzf'

alias actions='gh workflow view 1653306'
alias pc='SKIP=tests pre-commit run'
