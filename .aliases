# External
alias myip="curl https://ipinfo.io/"
alias weather="curl https://wttr.in/"

# System
alias ls="ls --color=auto"

alias zshrc="exec zsh"
alias bashrc="exec bash"
alias v="nvim"
alias tmux="tmux -u"
# New/attach tmux session named after current dir (or pass a name)
tn() { tmux -u new -As "$(echo "${1:-${PWD:t}}" | tr . _)"; }
alias remove="sudo apt-get --purge autoremove"
# Secret code lives in ~/.croc-code (untracked): echo "<code>" > ~/.croc-code && chmod 600 ~/.croc-code
alias croc='croc $(cat ~/.croc-code)'
alias croc-send='\croc send --code $(cat ~/.croc-code)'

# Git
alias gi="git init"
alias gra="git remote add origin"
alias gset="git remote set-url origin"
alias ga="git add"
alias gaa="git add --all"
alias gau="git add -u"
alias gs="git status"
alias gp="git push"
alias gpf="git push -f"
alias gpp="git push -u origin HEAD"
alias gl="git pull --rebase --tags"
alias glu="git pull upstream"
alias gsh="git switch"
alias gsc="git switch -c"
alias glg="git log"
alias gbm="git branch -m"
alias gbd="git branch -D"
alias gcp="git cherry-pick"
alias gcl="git clone"
alias clone="gh repo clone"
alias gcln="git clean -df"
alias gc="git commit -m"
alias gcn="git commit -n -m"
alias gca="git commit -e --amend -n" # Edit last commit message
alias gcan="git commit --amend --no-edit -n" # Add changes to last commit
alias gd="git diff"
alias gdn="git diff --name-only"
alias gds="git diff --staged"
alias gdsn="git diff --staged --name-only"
alias gdsi="git-staged-diff"
alias gdp="gh pr diff"
alias gdf="git diff --name-only"
alias gdw="gh pr diff --web"
alias gr="git restore"
alias grs="git restore --staged"
alias grm="git rm -r --cached"
alias gbc="git branch --show-current | pbcopy"
alias gsa="git stash"
alias gsp="git stash pop"
alias grb="git-recent-branches"
gwt() { local d; d=$(git-worktree-select) && [ -n "$d" ] && cd "$d"; }
alias es="edit-staged"
alias qc="qcommit"
alias gvert="git revert"
alias merge="git merge"
alias sm="sync-with-master"
ecommit() { git commit --allow-empty -m "chore(empty): $*"; }

# Github
alias gh-prs="gh pr list -A rocktimsaikia"
alias gmerge="gh pr merge"
alias gcheck="gh pr checks"
alias gcreate="gh pr create --assignee @me"
