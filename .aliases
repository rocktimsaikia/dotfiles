# Company
alias dc="docker compose"
alias cg="cd ~/main 2>/dev/null || cd ~/codingal/main"
alias cgw="cd ~/main/web 2>/dev/null || cd ~/codingal/main/web"
alias cgp="cd ~/main/api 2>/dev/null || cd ~/codingal/main/api"
alias cgpy="dc exec api ./manage.py shell_plus"
alias cgdb="docker exec -it cgdb mysql -u root -p"
alias cgpm="dc exec api ./manage.py"
alias cgv="source ~/.pyenv/versions/bin/activate"
alias cgsh="docker compose exec api bash"

# Start/attach the `codingal` tmux session, syncing master on first launch
codingal() {
  local session="codingal"
  if ! tmux has-session -t "$session" 2>/dev/null; then
    tmux new-session -d -s "$session" -c ~/main
    tmux send-keys -t "$session" "git checkout master && git pull && cc" C-m
  fi
  if [ -n "$TMUX" ]; then
    tmux switch-client -t "$session"
  else
    tmux attach-session -t "$session"
  fi
}

## Files
alias eA="nvim ~/.aliases"
