maximize
keybind = shift+enter=text:\n

# Window switching belongs to tmux (alt+N -> select-window), so stop Ghostty
# from eating alt+N for its own tabs. Both spellings exist in the defaults:
# alt+digit_N is physical-key, alt+N is logical.
keybind = alt+digit_1=unbind
keybind = alt+1=unbind
keybind = alt+digit_2=unbind
keybind = alt+2=unbind
keybind = alt+digit_3=unbind
keybind = alt+3=unbind
keybind = alt+digit_4=unbind
keybind = alt+4=unbind
keybind = alt+digit_5=unbind
keybind = alt+5=unbind
keybind = alt+digit_6=unbind
keybind = alt+6=unbind
keybind = alt+digit_7=unbind
keybind = alt+7=unbind
keybind = alt+digit_8=unbind
keybind = alt+8=unbind
keybind = alt+digit_9=unbind
keybind = alt+9=unbind

# macOS sends Option as a compose key (option+o -> ø), so tmux never sees M-o.
# Ignored on Linux.
macos-option-as-alt = true

# Selecting text copies to the system clipboard, not just PRIMARY. Default `true`
# only fills PRIMARY on Linux (middle-click paste), so selections outside tmux
# never showed up on Ctrl+Shift+V -- inside tmux they did, via OSC 52.
copy-on-select = clipboard

font-family = DejaVu Sans Mono
font-size = 11
theme = Adventure
