# Linux-specific zsh configuration

# Neovim: skip the /snap/bin/nvim wrapper, it costs ~90ms per launch.
# nvim's snap is classic confinement, so the raw binary is the same program.
if [[ -x /snap/nvim/current/usr/bin/nvim ]]; then
	alias nvim=/snap/nvim/current/usr/bin/nvim
	export EDITOR=/snap/nvim/current/usr/bin/nvim
fi

# Bun
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"

# Pyenv configuration
export PYENV_ROOT=$HOME/.pyenv
export PATH=$PYENV_ROOT/bin:$PATH
eval "$(pyenv init --path)"
eval "$(pyenv init -)"
eval "$(pyenv virtualenv-init -)"

# Checks if the current dir contains any venv and activates on cd
function activatevenv() {
	if [[ -d "$PWD/venv" ]]; then
		source "$PWD/venv/bin/activate"
	fi
}

function cd() {
	builtin cd $1
	activatevenv
}

# Codingal: api/.env is gitignored, so git worktrees never get one and Django
# dies on `Set the DJANGO_SECRET_KEY environment variable`. Point every local
# manage.py run at the main checkout's copy instead of copying it per worktree
# (copies drift). Docker is unaffected - compose sets its own ENV_PATH.
export ENV_PATH="$HOME/main/api/.env"

# Go
export PATH="$HOME/.local/go/bin:$PATH"
export PATH="$HOME/go/bin:$PATH"

# Pipx
export PATH="$PATH:/home/$USERNAME/.local/bin"

