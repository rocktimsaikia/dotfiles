#!/bin/sh
# ponytail: claude-mem plugin leaks one chroma-mcp per session; reap ones whose
# parent/grandparent is systemd (session dead). Remove if plugin ever fixes cleanup.
for pid in $(pgrep -f chroma-mcp); do
  pp=$(ps -o ppid= -p "$pid" 2>/dev/null | tr -d ' ')
  [ -z "$pp" ] && continue
  pcomm=$(ps -o comm= -p "$pp" 2>/dev/null)
  gp=$(ps -o ppid= -p "$pp" 2>/dev/null | tr -d ' ')
  gcomm=$(ps -o comm= -p "$gp" 2>/dev/null)
  if [ "$pcomm" = "systemd" ]; then
    kill "$pid" 2>/dev/null
  elif [ "$gcomm" = "systemd" ] && { [ "$pcomm" = "uv" ] || [ "$pcomm" = "uvx" ]; }; then
    kill "$pp" "$pid" 2>/dev/null
  fi
done
