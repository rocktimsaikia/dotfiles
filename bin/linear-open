#!/usr/bin/env bash

# Open a Linear issue in the browser.
# Usage: linear-open [CE-1234 | "CE-1234 some title"]
# No argument -> the current tmux window's name, whose first word is the id.

set -euo pipefail

ORG=codingal

arg="${1:-$(tmux display -p '#{window_name}' 2>/dev/null || true)}"
id=${arg%% *}

[[ $id =~ ^[A-Z]+-[0-9]+$ ]] || {
	echo "not a Linear id: ${id:-<empty>}" >&2
	exit 1
}

# The bare-identifier URL redirects to the slugged one, so no API call needed.
xdg-open "https://linear.app/$ORG/issue/$id" >/dev/null 2>&1 &
