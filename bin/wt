#!/bin/bash
# wt <name> - create a worktree with its own branch off latest origin/master
# and print its path. Idempotent: an existing worktree just prints its path.
# cd can't happen from a subprocess, so callers wrap it: cd "$(wt <name>)".
set -e

BRANCH_PREFIX="rocktimsaikia/"

# Work on whatever repo we are standing in, falling back to the Codingal
# checkout. --git-common-dir (not --show-toplevel) so running this from inside a
# worktree still resolves to the main checkout instead of nesting.
REPO=$(dirname "$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" 2>/dev/null)
[ -d "$REPO/.git" ] || REPO="$HOME/main"

# ~/worktrees/<repo>/<name>
BASE_DIR="$HOME/worktrees/$(basename "$REPO")"

# master here, main elsewhere -- ask the remote rather than assuming. The
# `|| true` matters: under `set -e` a failed command substitution in an
# assignment kills the script, and origin/HEAD is missing more often than not.
BASE_BRANCH=$(git -C "$REPO" symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null || true)
BASE_BRANCH=${BASE_BRANCH#origin/}

if git -C "$REPO" remote get-url origin >/dev/null 2>&1; then
	BASE_BRANCH=${BASE_BRANCH:-master}
	START="origin/$BASE_BRANCH"
else
	# Local-only repo: nothing to fetch, so branch off its own default branch.
	BASE_BRANCH=${BASE_BRANCH:-$(git -C "$REPO" branch --show-current || true)}
	START=${BASE_BRANCH:-HEAD}
fi

name="$1"
if [ -z "$name" ]; then
	echo "usage: wt <name>" >&2
	exit 1
fi

# Accept either the short name or a fully-qualified branch (e.g. pasted from
# `git branch`); strip the prefix so an existing branch doesn't end up as
# rocktimsaikia/rocktimsaikia/<name>.
name=${name#"$BRANCH_PREFIX"}

branch="$BRANCH_PREFIX$name"
dir="$BASE_DIR/$name"

# If the branch is already checked out in another worktree, open that worktree
# instead of trying to create a duplicate directory for it.
existing_dir=$(git -C "$REPO" worktree list --porcelain | awk -v branch="refs/heads/$branch" '
	$1 == "worktree" { dir = substr($0, 10) }
	$1 == "branch" && $2 == branch { print dir; exit }
')
[ -z "$existing_dir" ] || dir="$existing_dir"

if [ ! -d "$dir" ]; then
	mkdir -p "$BASE_DIR"
	# Progress chatter to stderr -- stdout is the path, and `git worktree add`
	# puts its "HEAD is now at ..." checkout line on stdout.
	if git -C "$REPO" show-ref --verify --quiet "refs/heads/$branch"; then
		git -C "$REPO" worktree add "$dir" "$branch" >&2
	else
		if [ "$START" != "${START#origin/}" ]; then
			git -C "$REPO" fetch origin "$BASE_BRANCH" >&2
		fi
		git -C "$REPO" worktree add "$dir" -b "$branch" "$START" >&2
	fi

	# node_modules is gitignored, so a fresh worktree has none and every node
	# tool breaks there -- typescript-language-server exits with "Could not find
	# a valid TypeScript installation". Borrow the main checkout's copy instead
	# of installing 1.2G per worktree; branches that change deps get main's
	# versions, which is already true of every tool run from the main checkout.
	# ponytail: root and web/ cover every repo here; add more paths if a
	# monorepo shows up with node_modules somewhere else.
	# --path-format=absolute: a bare --git-common-dir prints ".git", which would
	# resolve against the caller's cwd instead of the repo.
	exclude="$(git -C "$REPO" rev-parse --path-format=absolute --git-common-dir)/info/exclude"
	for rel in node_modules web/node_modules; do
		[ -d "$REPO/$rel" ] && [ ! -e "$dir/$rel" ] || continue
		mkdir -p "$(dirname "$dir/$rel")"
		ln -s "$REPO/$rel" "$dir/$rel"
		# The repo ignores "node_modules/" -- trailing slash, so directories
		# only. A symlink is not a directory and would show up as untracked,
		# one `git add -A` away from being committed. info/exclude is shared by
		# every worktree, so this is a one-time fixup per clone.
		grep -qxF "$rel" "$exclude" 2>/dev/null ||
			printf '%s\n' "$rel" >>"$exclude"
	done
fi

echo "$dir"
