#!/bin/bash
# wt [-c] <name> - create a worktree with its own branch off latest origin/master,
# then open it in a tmux window (inside tmux) or session (outside).
# -c also launches Claude there. Idempotent: existing worktree just opens tmux.
set -e

REPO="$HOME/main"
BASE_DIR="$HOME/codingal/worktrees"
BRANCH_PREFIX="rocktimsaikia/"
BASE_BRANCH="master"

# cc is a zsh function, so it has to be typed into the shell, not exec'd by tmux.
cmd=""
if [ "$1" = "-c" ]; then
	cmd="cc"
	shift
fi

name="$1"
if [ -z "$name" ]; then
	echo "usage: wt [-c] <name>"
	exit 1
fi

dir="$BASE_DIR/$name"

if [ ! -d "$dir" ]; then
	mkdir -p "$BASE_DIR"
	git -C "$REPO" fetch origin "$BASE_BRANCH"
	git -C "$REPO" worktree add "$dir" -b "$BRANCH_PREFIX$name" "origin/$BASE_BRANCH"

	# node_modules is gitignored, so a fresh worktree has none and every node
	# tool breaks there -- typescript-language-server exits with "Could not find
	# a valid TypeScript installation". Borrow the main checkout's copy instead
	# of installing 1.2G per worktree; branches that change deps get main's
	# versions, which is already true of every tool run from the main checkout.
	if [ -d "$REPO/web/node_modules" ] && [ ! -e "$dir/web/node_modules" ]; then
		ln -s "$REPO/web/node_modules" "$dir/web/node_modules"
		# The repo ignores "node_modules/" -- trailing slash, so directories
		# only. A symlink is not a directory and would show up as untracked,
		# one `git add -A` away from being committed. info/exclude is shared by
		# every worktree, so this is a one-time fixup per clone.
		exclude="$(git -C "$REPO" rev-parse --git-common-dir)/info/exclude"
		grep -qxF 'web/node_modules' "$exclude" 2>/dev/null ||
			printf 'web/node_modules\n' >>"$exclude"
	fi
fi

# "CE-8334 Fix the thing" - the status bar shows only the id until the window is
# active (see tmux.conf). No key/no such issue/offline -> plain id.
label="$name"
title=$(linear-title "$name" 2>/dev/null) && label="$name $title"

if [ -n "$TMUX" ]; then
	tmux new-window -c "$dir" -n "$label"
	if [ -n "$cmd" ]; then tmux send-keys "$cmd" C-m; fi
else
	# Detached create so cmd can be sent before attaching (blocks).
	if ! tmux -u has-session -t "=$name" 2>/dev/null; then
		tmux -u new -ds "$name" -c "$dir" -n "$label"
		if [ -n "$cmd" ]; then tmux send-keys -t "=$name" "$cmd" C-m; fi
	fi
	tmux -u attach -t "=$name"
fi
