#!/usr/bin/env bash

set -euo pipefail

current_dir=${1:-$PWD}

fzf=$(command -v fzf || true)
if [[ -z $fzf && -x /opt/homebrew/bin/fzf ]]; then
	fzf=/opt/homebrew/bin/fzf
fi

if [[ -z $fzf ]]; then
	tmux display-message "fzf is required for the directory picker"
	exit 1
fi

directory=$(
	{
		printf '%s\n' "$current_dir"
		find "$HOME" -mindepth 1 -maxdepth 1 -type d ! -name '.*' -print 2>/dev/null
	} | awk '!seen[$0]++' | "$fzf" --no-sort --height=100% --reverse --prompt='Directory> '
) || exit 0

default_name=$(basename "$directory")
printf 'New session name [%s]: ' "$default_name" >&2
IFS= read -r session_name
session_name=${session_name:-$default_name}

tmux new-session -d -s "$session_name" -c "$directory"
tmux switch-client -t "$session_name"
