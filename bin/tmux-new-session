#!/usr/bin/env bash

set -euo pipefail

current_dir=${1:-$PWD}

fzf=$(command -v fzf || true)
if [[ -z $fzf && -x /opt/homebrew/bin/fzf ]]; then
	fzf=/opt/homebrew/bin/fzf
fi

if [[ -z $fzf ]]; then
	tmux display-message "fzf is required for the directory picker"
	exit 1
fi

directories=()
if [[ -d "$current_dir/.git" ]]; then
	directories+=("$current_dir")
fi
while IFS= read -r -d '' dir; do
	[[ -d "$dir/.git" ]] && directories+=("$dir")
done < <(find "$HOME" -mindepth 1 -maxdepth 1 -type d ! -name '.*' -print0 2>/dev/null)

# ponytail: directory mtime approximates activity; track picker selections if precision matters.
directory=$(
	((${#directories[@]})) && ls -dt "${directories[@]}" | awk '!seen[$0]++' |
		sed "s|^$HOME|~|" |
		"$fzf" --no-sort --height=100% --reverse --prompt='Directory> '
) || exit 0

directory=${directory/#\~/$HOME}
default_name=$(basename "$directory")
printf 'New session name [%s]: ' "$default_name" >&2
IFS= read -r session_name
session_name=${session_name:-$default_name}

tmux new-session -d -s "$session_name" -c "$directory"
tmux switch-client -t "$session_name"
